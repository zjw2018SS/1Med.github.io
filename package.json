{
  "name": "1med",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run tools:vendor && vite",
    "build": "npm run tools:vendor && npm run chaoxing:build && vite build && node scripts/sync-static-assets.mjs",
    "preview": "vite preview",
    "test": "node --test src/features/exercise/*.test.js",
    "lint": "eslint \"src/**/*.{js,vue}\" \"scripts/*.mjs\" \"tools/chaoxing-to-json/src/**/*.js\" \"tools/chaoxing-to-json/vite.config.js\" \"tools/userscript-framework/**/*.js\" \"vite.config.js\"",
    "format": "prettier --write \"src/**/*.{js,vue,css}\" \"scripts/*.mjs\" \"tools/chaoxing-to-json/src/**/*.{js,css}\" \"tools/userscript-framework/**/*.js\" \"*.config.js\"",
    "tools:vendor": "node scripts/sync-tools-vendor.mjs",
    "chaoxing:dev": "npm run chaoxing:build && vite --host 0.0.0.0 --open /tools/chaoxing-to-json/dist/chaoxingRedo.user.js",
    "chaoxing:hmr": "vite --config tools/chaoxing-to-json/vite.config.js --host 0.0.0.0",
    "chaoxing:build": "vite build --config tools/chaoxing-to-json/vite.config.js"
  },
  "dependencies": {
    "@lucide/vue": "^1.17.0",
    "pinia": "^3.0.4",
    "sweetalert2": "^11.26.25",
    "vue": "^3.5.11",
    "vue-router": "^4.6.4",
    "vue-sweetalert2": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "vite": "^8.0.15",
    "vite-plugin-monkey": "^8.0.6",
    "vite-plugin-pwa": "^1.3.0"
  }
}
